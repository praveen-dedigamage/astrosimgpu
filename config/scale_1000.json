// 1000 astrocytes and 5000 neurons, ten times the default network.
//
// Block connectivity requires the neuron count to be a multiple of the
// astrocyte count, so N_A = (N_E + N_I) / 5 as in use_case.json.
//
// The transient and recorded window are short because this configuration
// exists to compare host and device throughput, not to produce statistics.
// At 1000 astrocytes the calcium measures are still computed but the window is
// too short for them to mean anything.

{
  "N": {
    "N_A": 1000,
    "N_E": 4000,
    "N_I": 1000
  },
  "simulation": {
    "dt": 0.1,
    "substeps": 1,
    "pre_sim_time": 2000,
    "sim_time": 10000,
    "seed": 1,
    "output_dir": "results/scale1000",
    "record_spikes": true,
    "record_astro": true,
    "record_neuron": false,
    "record_every": 100,
    "record_astro_max": 100,
    "record_neuron_max": 50
  },
  "astrocyte": {
    "Ca_tot": 1.8958264782990153,
    "IP3_0": 0.010925583871830699,
    "IP3": 0.010925583871830699,
