// Astrocyte kernel throughput against population size.
//
// The neuron population is fixed at 500 and the astrocyte count is set on the
// command line with --astrocytes, so the host work stays constant and the only
// thing that varies is the size of the offloaded loop. Random pools make this
// possible: block pools tie the astrocyte count to the neuron count.
//
// At large astrocyte counts most astrocytes are never recruited by any
// synapse. That is intended. They are still integrated every step, which is
// exactly the cost being measured.
//
// Recording and analysis are off. This configuration measures throughput and
// its output is not a result about the model.

{
  "N": {
    "N_A": 100,
    "N_E": 400,
    "N_I": 100
  },
  "simulation": {
    "dt": 0.1,
    "substeps": 1,
    "pre_sim_time": 1000,
    "sim_time": 5000,
    "seed": 1,
    "output_dir": "results/kernel-scaling",
    "record_spikes": false,
    "record_astro": false,
    "record_neuron": false,
    "record_every": 100,
    "record_astro_max": 100,
    "record_neuron_max": 50
  },
  "astrocyte": {
    "Ca_tot": 1.8958264782990153,
    "IP3_0": 0.010925583871830699,
