#!/bin/bash
#SBATCH --job-name=project_2020566-astrosimgpu-neuron-scaling
#SBATCH --account=project_2020566
#SBATCH --partition=gputest
#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=72
#SBATCH --gres=gpu:gh200:1
#SBATCH --output=neuron-scaling-%j.out
#SBATCH --error=neuron-scaling-%j.err

# Fixed-in-degree neuron-scaling sweep: both astrocytes and neurons grow
# together (config/neuron_scale_*.json, generated by
# scripts/roihu/gen_neuron_scaling_configs.py), unlike kernel_scaling.json
# which holds neurons fixed at 500 to isolate the astrocyte phase.
#
# Question this answers: where does update_neuron (host CPU, not yet ported)
# overtake drive_astrocytes / the GPU astrocyte kernel as the dominant cost,
# once the network is grown the biologically defensible way? See
# docs/experiments.md's 93.1% figure at 1000 astro / 5000 neurons -- this
# sweep checks whether that holds across the full range and confirms it on
# the actual CUDA backend rather than the host-only build.
#
# Up to 10,000,000 neurons: connectivity generation uses geometric-skip
# sampling (O(expected connections), not the old dense O(N_neurons x N_astro)
# sweep), so generation itself is fast at any of these sizes. Memory is the
# real ceiling -- about 40 bytes per stored connection, so 10,000,000 neurons
# is roughly 57.5 GB. That fits a GH200 node's host RAM but not a laptop --
# do not try the two largest sizes outside Roihu. The measurement window is
# short (50 transient + 200 recorded steps) specifically so update_neuron's
# linear-in-N cost (~805 ms/step by 10,000,000) does not blow the gputest
# time limit on the largest points.
#
# Build first, from roihu-gpu.csc.fi:
#
#   module load nvhpc/26.3
#   cmake -S . -B build-cuda -DCMAKE_BUILD_TYPE=Release \
#       -DASTROSIMGPU_CUDA=ON -DASTROSIMGPU_NATIVE=ON
#   cmake --build build-cuda -j16
#
# Then:
#
#   python3 scripts/roihu/gen_neuron_scaling_configs.py   # regenerate if needed
#   sbatch scripts/roihu/neuron_scaling.sbatch

set -uo pipefail

module load nvhpc/26.3

# Idle OpenMP threads spin-wait by default. deliver_spikes/apply_arrivals
# run serially between two large parallel regions (drive_astrocytes,
# update_neuron) every step; on a 72-core node the 71 idle spinning
# threads contend for memory/cache bandwidth with that serial code and
# inflate its measured cost by roughly 10x -- confirmed empirically: at
# 10,000 neurons deliver phases measured 47.37% active vs 4.84% passive,
# update_neuron 34.21% vs 93.09%, the latter matching the host-only build.
# This has nothing to do with the model; it is purely a wait-policy
# artifact on many-core hardware.
export OMP_WAIT_POLICY=PASSIVE

BIN=build-cuda/astrosimgpu
if [[ ! -x "$BIN" ]]; then
    echo "MISSING: $BIN -- build it first, see the header of this script" >&2
    exit 1
fi

echo "account: ${SLURM_JOB_ACCOUNT:-unknown}"
echo "host   : $(hostname)   arch: $(uname -m)   cores: $(nproc)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
echo

SIZES="${SIZES:-500 1000 2000 5000 10000 100000 1000000 10000000}"

# Every run appends to this CSV, tagged with the git commit that produced it,
# so "did this change actually help" is a lookup instead of a manual diff
# between two job outputs. HISTORY_COLS documents the column order used by
# both the writer below and the lookup that reads it back.
HISTORY="${HISTORY:-results/sweep_history.csv}"
HISTORY_COLS="timestamp,jobid,commit,neurons,N_A,synapses,max_astro_deg,astro_pct,neuron_pct,deliver_pct,other_pct,us_step,wall_s"
mkdir -p "$(dirname "$HISTORY")"
if [[ ! -f "$HISTORY" ]]; then
    echo "$HISTORY_COLS" > "$HISTORY"
fi
COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
echo "history: $HISTORY (commit $COMMIT)"
echo

printf "%-10s %10s %10s %14s %10s %10s %10s %10s %14s %12s %10s\n" \
    "neurons" "N_A" "synapses" "max_astro_deg" "astro%" "neuron%" "deliver%" "other%" "us/step" "prev_us/step" "delta"
printf '%.0s-' {1..135}; echo

for n in $SIZES; do
    cfg="config/neuron_scale_${n}.json"
    if [[ ! -f "$cfg" ]]; then
        echo "MISSING: $cfg -- run scripts/roihu/gen_neuron_scaling_configs.py first" >&2
        exit 1
    fi

    out="/tmp/neuron-scaling.$$-$n.out"
    srun --export=ALL "$BIN" --config "$cfg" \
        -o "results/neuron-scale-${n}-${SLURM_JOB_ID:-local}" > "$out" 2>&1
    status=$?
    if [[ $status -ne 0 ]]; then
        echo "FAILED (exit $status): $cfg -- see $out" >&2
        tail -30 "$out" >&2
        continue
    fi

    n_a=$(awk '/^astrocytes / {print $2}' "$out")
    max_deg=$(awk '/max astro out-degree/ {print $4}' "$out")
    n2a=$(awk '/neuron -> astrocyte/ {print $4}' "$out")
    a2n=$(awk '/astrocyte -> neuron/ {print $4}' "$out")
    n_primary_exc=$(awk '/exc -> neuron synapses/ {print $5}' "$out")
    n_primary_inh=$(awk '/inh -> neuron synapses/ {print $5}' "$out")
    synapses=$(( ${n_primary_exc:-0} + ${n_primary_inh:-0} + ${n2a:-0} + ${a2n:-0} ))
    astro_pct=$(awk '/^update astrocytes/ {print $4}' "$out")
    neuron_pct=$(awk '/^update neurons/ {print $4}' "$out")
    deliver_pct=$(awk '/^spike delivery/ {s=$4} /^SIC gather\+deliver/ {s+=$4} /^arrival application/ {s+=$4} END {printf "%.4f", s}' "$out")
    other_pct=$(awk '/^other \(I\/O, loop\)/ {print $5}' "$out")
    total_s=$(awk '/^total / {print $2}' "$out")
    wall_s=$(awk '/wall clock/ {print $3}' "$out")
    recorded_ms=$(awk '/^recorded / {print $2}' "$out")
    dt=$(awk '/^dt / {print $2}' "$out")
    steps=$(awk -v r="$recorded_ms" -v d="$dt" 'BEGIN{printf "%d", r/d}')
    us_step=$(awk -v t="$total_s" -v s="$steps" 'BEGIN{ if (s>0) printf "%.2f", t*1e6/s; else print "n/a" }')

    # Most recent PRIOR row for this exact size, before this run's own row is
    # appended -- column 12 is us_step, column 4 is neurons, per HISTORY_COLS.
    prev_us_step=$(awk -F, -v n="$n" 'NR>1 && $4==n {prev=$12} END{if (prev!="") print prev}' "$HISTORY")
    if [[ -n "$prev_us_step" && "$prev_us_step" != "n/a" && "$us_step" != "n/a" ]]; then
        delta=$(awk -v p="$prev_us_step" -v c="$us_step" \
            'BEGIN{ printf "%+.1f%%", (p-c)/p*100 }')
    else
        delta="(none)"
        prev_us_step="-"
    fi

    printf "%-10s %10s %10s %14s %10s %10s %10s %10s %14s %12s %10s\n" \
        "$n" "${n_a:-?}" "${synapses:-?}" "${max_deg:-?}" "${astro_pct:-?}" \
        "${neuron_pct:-?}" "${deliver_pct:-?}" "${other_pct:-?}" "${us_step:-?}" \
        "$prev_us_step" "$delta"

    echo "${TIMESTAMP},${SLURM_JOB_ID:-local},${COMMIT},${n},${n_a:-},${synapses:-}," \
         "${max_deg:-},${astro_pct:-},${neuron_pct:-},${deliver_pct:-},${other_pct:-}," \
         "${us_step:-},${wall_s:-}" | tr -d ' ' >> "$HISTORY"

    cp "$out" "neuron-scaling-${n}-${SLURM_JOB_ID:-local}.out"
done

echo
echo "delta is us/step change vs the most recent PRIOR run of the same size in"
echo "$HISTORY (positive = faster, negative = slower); '(none)' means no prior"
echo "entry exists yet for that size."
echo "Per-config full output saved as neuron-scaling-<n>-<jobid>.out"
echo "Configs regenerated with: python3 scripts/roihu/gen_neuron_scaling_configs.py"
